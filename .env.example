# Host ports (avoid 5433/5173/8080 and 8081/5174 used on the owner's PC).
DB_PORT=5435
API_PORT=8181
VITE_PORT=5191
VITE_API_URL=http://localhost:8181

# Server (doctalk-server). Render sets PORT; locally API_PORT wins if both are set.
PORT=8181
DATABASE_URL=postgres://doctalk:doctalk@localhost:5435/doctalk?sslmode=disable
CORS_ORIGIN=http://localhost:5191
STORAGE_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760

# Gemini (free tier). Never commit a real key. CI tests mock Gemini and do not need this.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_CHAT_FALLBACK_MODEL=
GEMINI_MAX_IN_FLIGHT=2
GEMINI_RETRY_BUDGET_SECONDS=8
ASK_TOP_K=5
ASK_TOP_K_MAX=20
ASK_TIMEOUT_SECONDS=60
