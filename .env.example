# Server (doctalk-server)
PORT=8080
DATABASE_URL=postgres://doctalk:doctalk@localhost:5432/doctalk?sslmode=disable
CORS_ORIGIN=http://localhost:5173

# Gemini (free tier). Used in Phase 2+. Leave empty for Phase 1 health checks.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Client (doctalk-client). Vite only reads vars prefixed with VITE_.
# Leave empty in local dev to use the Vite proxy (/health -> localhost:8080).
VITE_API_URL=http://localhost:8080
