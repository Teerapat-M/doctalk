# Host ports (avoid 5433/5173/8080, 8081/5174, 5191, and 4317 used on the owner's PC).
DB_PORT=5435
API_PORT=8181
VITE_PORT=3917
# Leave VITE_API_URL unset so the Vite proxy is used (same-origin; no CORS in the browser).

# Server (doctalk-server). Render sets PORT; locally API_PORT wins if both are set.
PORT=8181
DATABASE_URL=postgres://doctalk:doctalk@localhost:5435/doctalk?sslmode=disable
CORS_ORIGIN=http://localhost:3917,http://127.0.0.1:3917
STORAGE_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760
MAX_PAGES=50
MAX_ROWS=2000

# Guest sessions (HS256 cookie). Placeholder only — never commit a real secret.
JWT_SECRET=change-me
GUEST_TTL_HOURS=168
QUIZ_PER_DAY=5
QUIZ_RESET_HOUR=7
ASK_PER_MINUTE=20
INGEST_PER_MINUTE=10

# Gemini (free tier). Never commit a real key. CI tests mock Gemini and do not need this.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_QUIZ_MODEL=
GEMINI_CHAT_FALLBACK_MODEL=
GEMINI_MAX_IN_FLIGHT=2
GEMINI_RETRY_BUDGET_SECONDS=8
QUIZ_N_MAX=20
ASK_TOP_K=5
ASK_TOP_K_MAX=20
ASK_TIMEOUT_SECONDS=60
