# Host ports (avoid 5433/5173/8080, 8081/5174, 5191, and 4317 used on the owner's PC).
DB_PORT=5435
API_PORT=8181
VITE_PORT=3917
# Leave VITE_API_URL unset so the Vite proxy is used (same-origin; no CORS in the browser).

# Server (doctalk-server). Render sets PORT; locally API_PORT wins if both are set.
PORT=8181
DATABASE_URL=postgres://doctalk:doctalk@localhost:5435/doctalk?sslmode=disable
CORS_ORIGIN=http://localhost:3917,http://127.0.0.1:3917
STORAGE_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760
MAX_PAGES=50
MAX_ROWS=2000

# Guest sessions (HS256 cookie). Must be at least 32 bytes.
# Generate: openssl rand -base64 32
# Never commit a real secret.
JWT_SECRET=replace-with-openssl-rand-base64-32
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# Cross-site (Vercel client to Render API): COOKIE_SECURE=true and COOKIE_SAMESITE=None
# Production values live in render.yaml; do not commit real secrets.
# Leave TRUSTED_PROXIES empty so client X-Forwarded-For is ignored.
# On Render, CLIENT_IP_HEADER=True-Client-IP (set in render.yaml).
TRUSTED_PROXIES=
CLIENT_IP_HEADER=
GUEST_TTL_HOURS=168
QUIZ_PER_DAY=5
QUIZ_RESET_HOUR=7
QUIZ_IP_PER_DAY=20
ASK_PER_MINUTE=20
INGEST_PER_MINUTE=10

# Supabase (production Storage + Postgres). Leave empty for local DiskStorage.
# Dashboard: Project URL, service_role key, Session pooler DATABASE_URL. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=doctalk-uploads

# Gemini (free tier). Never commit a real key. CI tests mock Gemini and do not need this.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBED_BATCH=16
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_QUIZ_MODEL=
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Alias for GEMINI_FALLBACK_MODEL (used only if GEMINI_FALLBACK_MODEL is unset).
GEMINI_CHAT_FALLBACK_MODEL=
GEMINI_MAX_IN_FLIGHT=2
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BUDGET_SECONDS=8
GEMINI_RETRY_BASE_DELAY_MS=500
GEMINI_RETRY_MAX_DELAY_MS=4000
# Idle / first-token timeout for Gemini streams (resets on each chunk). Must be >= 5.
GEMINI_REQUEST_TIMEOUT_SECONDS=25
# Hard cap on a single Gemini HTTP call (chat stream, quiz, embed). Must be >= idle timeout.
GEMINI_TOTAL_TIMEOUT_SECONDS=90
QUIZ_N_MAX=20
ASK_TOP_K=5
ASK_TOP_K_MAX=20
ASK_TIMEOUT_SECONDS=60
